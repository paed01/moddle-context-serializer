{
  "name": "moddle-context-serializer",
  "version": "7.0.0",
  "description": "Make bpmn-moddle context serializable and mapped to behaviour functions",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "browser": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "mocha",
    "posttest": "npm run lint && npm run toc && npm run build:types && texample ./README.md ./API.md",
    "test:lcov": "c8 -r lcov mocha && npm run lint && npm run build:types",
    "cov:html": "c8 -r html -r text mocha",
    "lint": "eslint . --cache && prettier . -c --cache && npm run typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "build:types": "node ./scripts/bundle-types.js",
    "toc": "toc -c ./README.md ./API.md",
    "prepack": "npm run toc && npm run build:types"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/paed01/moddle-context-serializer.git"
  },
  "homepage": "https://0dep.se/run/",
  "author": {
    "name": "Pål Edman",
    "url": "https://0dep.se/about/"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "types/index.d.ts",
    "types/index.d.ts.map"
  ],
  "keywords": [
    "bpmn",
    "bpmn 2",
    "bpmn-moddle",
    "moddle",
    "bpmn-engine",
    "workflow",
    "serializer",
    "serializable",
    "deserializable",
    "isomorphic"
  ],
  "peerDependencies": {
    "bpmn-moddle": ">=6"
  },
  "devDependencies": {
    "@0dep/toc": "^2.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bpmn-moddle": "^10.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "bpmn-elements": "^18.1.1",
    "bpmn-moddle": "^10.3.1",
    "bpmn-moddle-6": "npm:bpmn-moddle@6",
    "bpmn-moddle-7": "npm:bpmn-moddle@7",
    "bpmn-moddle-9": "npm:bpmn-moddle@9",
    "c8": "^12.0.0",
    "camunda-bpmn-moddle": "^8.0.2",
    "camunda-bpmn-moddle-6": "npm:camunda-bpmn-moddle@6",
    "camunda-bpmn-moddle-7": "npm:camunda-bpmn-moddle@7",
    "chai": "^6.2.0",
    "dts-buddy": "^0.8.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "mocha": "^12.0.3",
    "prettier": "^3.2.5",
    "texample": "^2.0.0"
  }
}
